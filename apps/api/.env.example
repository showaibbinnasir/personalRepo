PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/showaib_portfolio
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=showaibbin.nasir1@gmail.com
ADMIN_PASSWORD=change-this-before-seeding
# Web origin(s) allowed to call the API. Comma-separate production + preview URLs.
FRONTEND_URL=http://localhost:3000
IMGBB_API_KEY=
OPENAI_API_KEY=
# Set this to a model available in your OpenAI account.
OPENAI_MODEL=
NODE_ENV=development
# Proxy hops in front of the API, for correct per-visitor rate limits.
# Local: 1. Production behind the website proxy + a host load balancer (e.g. Render): 2.
TRUST_PROXY=1
# Optional: instant cache refresh on the website after every CMS save.
# Use the same value as REVALIDATE_SECRET in apps/web/.env.local.
REVALIDATE_SECRET=
# Optional: where to send the refresh call (defaults to the first FRONTEND_URL).
WEB_URL=
