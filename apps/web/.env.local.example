# Where the Express API runs. The browser never calls it directly: the site
# proxies /backend/* to this address, so the admin login cookie is first-party.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Public origin of this site (canonical URLs, sitemap, RSS, share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Google Analytics 4 measurement ID, e.g. G-XXXXXXX
NEXT_GA_ID=
# Optional: lets the API refresh cached pages instantly after CMS saves.
# Must match REVALIDATE_SECRET in apps/api/.env
REVALIDATE_SECRET=
